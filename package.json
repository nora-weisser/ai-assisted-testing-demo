{
  "name": "ai-assisted-testing-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "app:dev": "npm --prefix app install && npm --prefix app run dev",
    "app:up": "docker compose up -d --wait",
    "app:down": "docker compose down -v",
    "test": "playwright test",
    "test:docker": "docker compose --profile test run --rm playwright"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
